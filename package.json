{
  "name": "lpl-scriptable",
  "version": "3.1.0",
  "private": true,
  "description": "Smart League of Legends tournament schedule widget for Scriptable",
  "scripts": {
    "test": "node tests/run-all.js",
    "test:schema": "node tests/schedule-schema.test.js",
    "tournament:build": "node scripts/build-tournament-data.js",
    "active:generate": "node scripts/generate-active.js",
    "dev:installer": "node scripts/build-dev-installer.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,yml}\"",
    "version:check": "node scripts/check-version.js",
    "release:notes": "node scripts/extract-release-notes.js",
    "check": "npm test && npm run version:check && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=18"
  }
}
